# .env example for smart contract deployment

# Blockchain node configuration
IP_ADDRESS=127.0.0.1
PORT_NUMBER=8545
CHAIN_ID=1337

# Deployment account configuration
ACCOUNT_ADDRESS=0x297875a2f7d2c9bd9e06b2ef26ff39d2aa51f498
PRIVATE_KEY=0x385ae368172d413be0f259bc09e5e41a8f73137e0c50fee3e528309eb0bef156

# Optionally, if you have a specific contract name you often deploy, you can set it as well
CONTRACT_NAME=HierarchicalVerification
